#!/bin/bash

###############################################################################
# iOS Device Tools - 설정 파일 템플릿
#
# 이 파일을 복사하여 'ios_device_config.sh'로 저장하고
# 프로젝트에 맞게 수정하세요.
#
# 사용법:
#   cp ios_device_config.template ios_device_config.sh
#   # ios_device_config.sh 파일을 편집
#
###############################################################################

# =============================================================================
# 프로젝트 설정
# =============================================================================

# 프로젝트 경로 (.xcodeproj 파일 경로)
PROJECT_PATH="/Users/cauca/Projects/ClothIQ-ClaudeCode/ClothIQ/ClothIQ.xcodeproj"

# 스킴 이름 (Xcode에서 확인)
SCHEME="ClothIQ"

# 번들 ID (Info.plist의 Bundle Identifier)
BUNDLE_ID="com.eunyeon.ClothIQ"

# 빌드 구성 (Debug 또는 Release)
CONFIGURATION="Debug"

# =============================================================================
# 디바이스 설정
# =============================================================================

# 디바이스 ID (비워두면 자동 감지)
# xcrun xctrace list devices 명령으로 확인 가능
DEVICE_ID=""

# =============================================================================
# 빌드 설정
# =============================================================================

# DerivedData 경로 (일반적으로 자동 설정됨)
DERIVED_DATA_PATH="${HOME}/Library/Developer/Xcode/DerivedData/ClothIQ-apwyeipwmugfhkckrbeahymrtxpi"

# 앱 경로 (비워두면 자동 설정)
APP_PATH=""

# 프로비저닝 자동 업데이트 (true 또는 false)
ALLOW_PROVISIONING_UPDATES="true"

# =============================================================================
# 로그 설정
# =============================================================================

# 로그 레벨 (debug, info, error)
LOG_LEVEL="debug"

# =============================================================================
# 크래시 로그 설정
# =============================================================================

# 디바이스 진단 정보 수집 여부 (true 또는 false)
# true로 설정하면 크래시 로그 수집 시 디바이스 전체 진단 정보도 수집
COLLECT_DEVICE_DIAGNOSTICS="false"

# =============================================================================
# 성능 프로파일링 설정
# =============================================================================

# 기본 프로파일링 템플릿
# 사용 가능한 템플릿: xcrun xctrace list templates
DEFAULT_PROFILE_TEMPLATE="Time Profiler"

# 기본 프로파일링 시간 (초)
DEFAULT_PROFILE_DURATION="30"
