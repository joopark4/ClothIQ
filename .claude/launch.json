{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "iOS Device Full Deploy",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/ios_device_tools.sh", "full-deploy"],
      "port": 0
    },
    {
      "name": "iOS Quick Deploy",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/quick_deploy.sh"],
      "port": 0
    },
    {
      "name": "ML Training Workflow",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/ml_training_workflow.sh"],
      "port": 0
    },
    {
      "name": "Train Keypoint Model",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/train_keypoint_model.py",
        "--data-path", "ClothIQ/ClothIQ/Documents/MLTrainingData",
        "--output-path", "models",
        "--epochs", "100"
      ],
      "port": 0
    },
    {
      "name": "Automated Tests",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/automated_test.sh"],
      "port": 0
    },
    {
      "name": "Monitor ML Data",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/test_data_collection.sh", "monitor"],
      "port": 0
    }
  ]
}
